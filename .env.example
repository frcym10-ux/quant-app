# J-Quants API リフレッシュトークン
# https://jpx-jquants.com/ で取得
# このファイルをコピーして .env という名前に変更し、実際のトークンを入力する
# .env は絶対にGitHubにpushしない！

JQUANTS_REFRESH_TOKEN=ここにJ-QuantsのリフレッシュトークンをペーストするJQT-xxxxx

# 口座設定（ポジションサイジング用）
ACCOUNT_CAPITAL=1000000        # 運用資金（円）
RISK_PERCENT=0.01              # 1トレードあたりのリスク率（1%）
