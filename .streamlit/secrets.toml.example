# .streamlit/secrets.toml のサンプル
# このファイルを secrets.toml にコピーして実値を入れる（secrets.toml は .gitignore 済み）。
# Streamlit Community Cloud では、アプリ設定の「Secrets」にこの中身を貼り付ける。
# トップレベルのキーは os.environ にも反映されるため、config/settings.py の os.getenv で読める。

# --- アプリのパスワードゲート（任意・多層防御） ---
# 設定するとアプリ全ページでパスワード入力を要求する。未設定なら認証なし。
# Community Cloudの「閲覧者をメールで限定」と併用すると堅牢。
APP_PASSWORD = "ここに好きなパスワード"

# --- J-Quants API（日本株データ・任意。未設定でも米国株とyfinance経由の日本株は動く） ---
JQUANTS_REFRESH_TOKEN = "JQT-xxxxx"

# --- 口座・運用設定（任意。未設定ならsettings.pyの既定値を使用） ---
ACCOUNT_CAPITAL = "1000000"
RISK_PERCENT = "0.01"
SWING_CAPITAL = "3000000"
SWING_RISK_PERCENT = "0.02"

# --- 保有銘柄（ポートフォリオ／保有サイン用・任意） ---
# portfolio.csv はクラウドに置かないため、JSON文字列で渡す。
HOLDINGS_JSON = '[{"code":"7011","name":"三菱重工業","avg_cost":1500},{"code":"2914","name":"JT","avg_cost":4000}]'

# --- 目標設定（任意） ---
GOAL_PROFIT = "1000000"
GOAL_START = "2026-06-16"
GOAL_DEADLINE = "2026-12-31"

# --- トレード記録のクラウド永続化（任意・推奨） ---
# 設定するとジャーナル（トレード記録）をSupabaseに保存し、再デプロイでも消えない。
# 未設定ならローカルCSV（data/trades.csv）に保存（従来どおり）。
# SUPABASE_KEY は service_role キー（Project Settings → API → service_role）を使う。
# service_role キーはサーバー側のsecretsにのみ置き、絶対に公開しない。
SUPABASE_URL = "https://imbrldrsohzpppdmrmcv.supabase.co"
SUPABASE_KEY = "ここにservice_roleキーを貼る（eyJ...）"
